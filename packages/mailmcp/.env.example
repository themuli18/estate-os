# Public URL (tunnel hostname), no trailing slash
PUBLIC_URL=https://mailmcp.example.org
# Google accounts allowed to sign in to /accounts and approve MCP clients (comma-separated)
OWNER_EMAILS=coordinator@example.org
# GCP OAuth client (type "Web application"), redirect URI: $PUBLIC_URL/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# openssl rand -hex 32  — encrypts Google refresh tokens at rest. Changing it invalidates stored accounts.
TOKEN_ENC_KEY=
# openssl rand -hex 32  — signs the admin session cookie
SESSION_SECRET=
# Optional: contact shown on /privacy and /terms (defaults to first OWNER_EMAILS entry)
# CONTACT_EMAIL=
# Optional: host port for docker compose (default 2310)
# HOST_PORT=2310
